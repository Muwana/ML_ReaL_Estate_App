<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic for your local development server -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.59.53</domain>
    </domain-config>

    <!-- For Android Emulators connecting to localhost -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>

    <!-- Trust the default system security settings for all other domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
